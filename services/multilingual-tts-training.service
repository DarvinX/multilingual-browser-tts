[Unit]
Description=Resume multilingual compact TTS training and model publication
After=multilingual-tts-release.service
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/multilingual-tts
Environment=PATH=%h/miniconda3/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/nvidia-smi --query-gpu=name --format=csv,noheader
ExecStart=/usr/bin/bash %h/multilingual-tts/train_queue.sh
Restart=on-failure
RestartSec=120
TimeoutStopSec=90

[Install]
WantedBy=default.target
